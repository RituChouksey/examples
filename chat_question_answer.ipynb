from telegram import Update, InlineKeyboardMarkup, InlineKeyboardButton, ParseMode
from telegram.ext import Updater, CommandHandler, MessageHandler, Filters, CallbackContext, CallbackQueryHandler
from transformers import pipeline
import wikipedia

status = 'initial'
chat = pipeline(
    "question-answering", model="ktrapeznikov/biobert_v1.1_pubmed_squad_v2", tokenizer="google-bert/bert-base-cased"
)


def echo(update: Update, context: CallbackContext) -> None:
    """
    This function would be added to the dispatcher as a handler for messages coming from the Bot API
    """

    # Print to console 
    print(f'{update.message.from_user.first_name} wrote {update.message.text}')

    global status
    global chat
    if (status == 'initial'):
        context.bot.send_message(
            update.message.chat_id,
            'Tell me a subject you want to talk about',
            # To preserve the markdown, we attach entities (bold, italic...)
            entities=update.message.entities
        )
        status = 'question'
    elif(status == 'question'):
        # response = wikipedia.search(update.message.text)
        # summary_response = []
        # for i in response:
        #     summary_response.append(wikipedia.summary(i))

        summary_response = wikipedia.summary(update.message.text)
      
        chat.context =  summary_response
        print(summary_response)
        context.bot.send_message(
          update.message.chat_id,
          'Ask me a question about this topic',
          # To preserve the markdown, we attach entities (bold, italic...)
          entities=update.message.entities
        )
        status = 'answer'
    elif(status == 'answer'):
        answer = chat(context = chat.context, question = update.message.text)
        context.bot.send_message(
            update.message.chat_id,
            answer,
            # To preserve the markdown, we attach entities (bold, italic...)
            entities=update.message.entities
        )
    #     # This is equivalent to forwarding, without the sender's name
    # update.message.copy(update.message.chat_id)
    
    if(update.message.text == 'reset'):
        status = 'initial'
        context.bot.send_message(
            update.message.chat_id,
            'lets restart',
            # To preserve the markdown, we attach entities (bold, italic...)
            entities=update.message.entities
        )
            

updater = Updater("XXXXXXXXXX")

# Get the dispatcher to register handlers
# Then, we register each handler and the conditions the update must meet to trigger it
dispatcher = updater.dispatcher


# Echo any message that is not a command
dispatcher.add_handler(MessageHandler(~Filters.command, echo))

# Start the Bot
updater.start_polling()

# Run the bot until you press Ctrl-C
updater.idle()
